{
  "services": {
    "xamlysis": {
      "root": ".",
      "runtime": "python",
      "entrypoint": "Online_Exam_Portal_Xamlysis/wsgi.py",
      "buildCommand": "bash build.sh"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "xamlysis"
      }
    }
  ]
}
